{
  "name": "dsh-workbench-memory",
  "version": "0.2.0",
  "description": "个人 DeepSeek Harness 工作台的「记忆库」独立包：记忆库页（原子卡片 + 3D 球棍关系图）+ 每轮有界召回并自动注入上下文（注入块标记为历史数据、非指令）。只注册记忆库这一页的插槽，可与其它三个单页包同时装。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "tools/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workbench",
    "dsh-workbench-memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
